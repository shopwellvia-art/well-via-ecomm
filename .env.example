# Compose-level env. Per-service envs live in backend/.env and frontend/.env.
MYSQL_ROOT_PASSWORD=root
MYSQL_DB=ecommerce
MYSQL_USER=ecom
MYSQL_PASSWORD=ecom_password

# Service-account bearer token for the payment reconciliation cron sidecar.
# Must belong to an account with the `payments.manage` permission only.
# Generate via: POST /api/v1/auth/service-token (or your admin panel).
PAYMENT_RECONCILE_TOKEN=
