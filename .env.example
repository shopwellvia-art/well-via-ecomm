# Root (compose-level) env — variables interpolated INTO docker-compose.yml.
# These are NOT passed into the containers; per-service config lives in
# backend/.env and frontend/.env.
#
# On the EC2 this file is optional: IMAGE_TAG defaults to `latest`, which the
# pipeline republishes on every deploy. Set it only to pin/roll back:
#
#   IMAGE_TAG=<git-sha> docker compose up -d
#
IMAGE_TAG=latest

# NOTE: MYSQL_* used to live here for a local mysql container. There is no
# longer one — production uses the external shared MySQL (configured in
# backend/.env), and tests use throwaway containers. Likewise
# PAYMENT_RECONCILE_TOKEN belongs in backend/.env: the reconcile sidecar reads
# the same env_file as the backend so the two can never drift apart.
