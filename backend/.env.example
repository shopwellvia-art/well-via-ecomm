ENVIRONMENT=development
DEBUG=true

SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=ecom
MYSQL_PASSWORD=ecom_password
MYSQL_DB=ecommerce
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

REDIS_URL=redis://redis:6379/0

CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

STRIPE_API_KEY=
EMAIL_FROM=noreply@example.com

# Image storage — "local" (dev) or "s3" (AWS S3 / DigitalOcean Spaces).
STORAGE_BACKEND=local
UPLOAD_DIR=uploads
# Leave blank: local uploads get a relative /media/... URL served same-origin
# via the Vite dev proxy and nginx /media location (works in dev and prod).
# Only set an absolute origin if /media lives on a different host than the app.
MEDIA_BASE_URL=
MAX_IMAGE_SIZE_MB=15
MAX_PRODUCT_IMAGES=8

# Fill these and set STORAGE_BACKEND=s3 to use cloud storage.
# AWS S3: leave S3_ENDPOINT_URL blank. DO Spaces: e.g. https://blr1.digitaloceanspaces.com
S3_ENDPOINT_URL=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_BASE_URL=

# Email — "console" (dev: logs the OTP) or "smtp" (real delivery).
EMAIL_BACKEND=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
OTP_TTL_MINUTES=10

# Google OAuth (server-side redirect). Create credentials in Google Cloud
# Console; register GOOGLE_REDIRECT_URI as an authorized redirect URI.
# Leave GOOGLE_CLIENT_ID blank to disable Google login.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
FRONTEND_URL=http://localhost:5173
