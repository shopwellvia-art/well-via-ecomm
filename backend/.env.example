ENVIRONMENT=development
DEBUG=true

SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=ecom
MYSQL_PASSWORD=ecom_password
MYSQL_DB=ecommerce
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Local-dev default. For docker-compose deployments set this to
# redis://redis:6379/0 in backend/.env so the containerised backend reaches the
# redis service instead of its own loopback (compose does NOT override it —
# the value comes straight from the env_file).
REDIS_URL=redis://localhost:6379/0

CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Reverse-proxy trust — peers allowed to set X-Forwarded-For (IP or CIDR).
# Behind the bundled nginx container the backend sees the Docker bridge IP, so
# the bridge subnet must be trusted here or every per-IP rate limit and account
# lockout collapses into one global bucket (one client can lock out everyone).
TRUSTED_PROXIES=["172.16.0.0/12","127.0.0.1","::1"]

# Bootstrap superadmin — re-seeded after a full DB truncate and by scripts/seed.py.
# Set a real email; leave the password BLANK to have a strong one generated and
# shown once (API response + logs). Never commit a real password here.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Admin

# Destructive DB maintenance (POST /admin/database/truncate|seed) is refused in
# production unless this is explicitly true for a supervised, one-off operation.
DB_ADMIN_OPS_ENABLED=false

# Where the gateway sends the customer's browser back after the payment screen;
# the SPA route there polls /payments/{mtid}/status. MUST be the customer-facing
# origin in production (e.g. https://shop.example.com/payments/return).
#
# ⚠️  Leaving this at the localhost default while ENVIRONMENT=production makes
# the backend REFUSE every prepaid checkout with "Online payment is temporarily
# unavailable" (app/services/payment_service.py) and log a `PAYMENT CONFIG:`
# CRITICAL line at boot. That guard exists because a dev-shaped return URL sent
# a real payer to their own localhost on 2026-08-03 — money captured, order
# stranded PENDING. COD is deliberately still allowed.
#
# In production you do NOT set this here: docker-compose.yml pins the live
# origin (https://shopwellvia.in) via its `x-public-origin` anchor, which
# overrides this file. The localhost values below are for bare-metal dev only.
PAYMENT_RETURN_URL=http://localhost:5173/payments/return
# The S2S callback URL handed to the gateway. Same rule: real origin in prod.
PAYMENT_WEBHOOK_URL=http://localhost:8000/api/v1/payments/webhook/phonepe

# Shared secret for the payment-reconcile-cron sidecar. It POSTs
# /api/v1/payments/admin/reconcile-pending every ~10 minutes with the header
# X-Reconcile-Token; the endpoint answers 403 unless the value matches this
# setting. docker-compose.yml wires BOTH the backend and the sidecar from this
# file (same env_file), so setting it here keeps the two in sync automatically.
# Generate: openssl rand -hex 32. Blank disables machine-auth reconcile (a
# signed-in admin with payments.manage can still trigger it manually).
PAYMENT_RECONCILE_TOKEN=

# Bearer token for the loyalty-cron sidecar (docker-compose.yml), which POSTs
# /api/v1/loyalty/admin/expire-points once a day. Unlike the reconcile token
# above this is NOT a backend setting: it is a long-lived service-account JWT
# carrying the loyalty.configure permission (see backend/docs/loyalty-cron.md
# for how to mint one). It lives here only so the sidecar (same env_file)
# can read it; the backend ignores the variable. Blank = the sidecar's daily
# POST fails 401 and points never expire automatically.
LOYALTY_CRON_TOKEN=

# --- Analytics v2 -----------------------------------------------------------
# Three independent kill switches, all off by default so the subsystem ships
# inert. Enable in this order, verifying each before the next:
#   1. ROLLUPS  — starts the analytics-worker container, the recompute queue and
#                 all agg_* writes. Write-only, nothing reads it, so this is the
#                 safe first step and lets rollups warm up / backfill.
#   2. V2       — exposes the v2 API, the /admin/analytics routes and the
#                 12-module sidebar. Legacy Sales/Profit pages stay primary
#                 until shadow-mode reconciliation passes.
#   3. TRACKING — data layer, GTM, GA4, Clarity, outbox delivery. Also needs the
#                 relaxed CSP in frontend/nginx.conf, which is rolled out
#                 Report-Only first.
# Turning a flag off is the primary rollback and needs no deploy.
ANALYTICS_ROLLUPS_ENABLED=false
ANALYTICS_V2_ENABLED=false
ANALYTICS_TRACKING_ENABLED=false

# Shared secret for machine-triggered analytics jobs, sent as X-Analytics-Token
# (same pattern as PAYMENT_RECONCILE_TOKEN above). The NORMAL path is the
# analytics-worker container, which calls the runner in-process and needs no
# token at all — this only authenticates manual/admin-UI triggers and any
# external scheduler. Generate: openssl rand -hex 32. Blank disables machine
# auth; a signed-in admin with analytics.jobs.run can still trigger runs.
ANALYTICS_CRON_TOKEN=

STRIPE_API_KEY=
EMAIL_FROM=noreply@example.com

# Image storage — "local" (dev) or "s3" (AWS S3 / DigitalOcean Spaces).
STORAGE_BACKEND=local
UPLOAD_DIR=uploads
# Leave blank: local uploads get a relative /media/... URL served same-origin
# via the Vite dev proxy and nginx /media location (works in dev and prod).
# Only set an absolute origin if /media lives on a different host than the app.
MEDIA_BASE_URL=
MAX_IMAGE_SIZE_MB=15
MAX_PRODUCT_IMAGES=8

# Fill these and set STORAGE_BACKEND=s3 to use cloud storage.
# AWS S3: leave S3_ENDPOINT_URL blank. DO Spaces: e.g. https://blr1.digitaloceanspaces.com
S3_ENDPOINT_URL=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_BASE_URL=
# Top-level bucket folder all uploads are organised under, e.g.
# wellvia/products/2026/06/<id>.jpg. Also editable in Admin → Settings → Storage.
S3_ROOT_PREFIX=wellvia
# Object ACL on upload. Blank for modern buckets (ACLs disabled); set
# public-read only for legacy ACL-enabled buckets.
S3_ACL=

# Email — "console" (dev: logs the OTP) or "smtp" (real delivery).
EMAIL_BACKEND=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
OTP_TTL_MINUTES=10

# Google OAuth (server-side redirect). Create credentials in Google Cloud
# Console; register GOOGLE_REDIRECT_URI as an authorized redirect URI.
# Leave GOOGLE_CLIENT_ID blank to disable Google login.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
FRONTEND_URL=http://localhost:5173
